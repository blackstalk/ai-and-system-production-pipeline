# Copy to .env and adjust as needed. Never commit a real .env file.

APP_NAME=ai-production-pipeline
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_ITEMS_PAGE_SIZE=100

# "stable" or "canary" — see docs/deployment-strategy.md
DEPLOYMENT_TRACK=stable

# --- CI / AI review workflow -------------------------------------------
# Required only by .github/workflows/ai-review.yml, as a GitHub Actions
# secret (Settings > Secrets and variables > Actions), never as a
# committed value. The workflow skips gracefully if this is unset.
ANTHROPIC_API_KEY=
